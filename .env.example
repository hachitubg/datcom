# Datcom environment example
# Copy this file to `.env` and change the sample values before deploy.

# App mode
# Use `production` on VPS/server. For local dev you can leave `development`.
NODE_ENV=development

# HTTP server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Session signing
# Production must set a real secret and keep it stable across restarts.
# Example generation:
# - openssl rand -hex 32
# - node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-session-secret

# Admin bootstrap
# Only used on first startup when the database does not already have an admin user.
ADMIN_INITIAL_PASSWORD=change-this-on-first-deploy

# Cookies
# 0 = local HTTP
# 1 = real HTTPS behind domain/reverse proxy
COOKIE_SECURE=0

# PayOS integration
# Leave empty if you do not use online payment yet.
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# Background sync interval for PayOS payment status, in milliseconds.
PAYOS_AUTO_SYNC_MS=30000

# Optional. Default is already the official PayOS merchant API URL.
PAYOS_BASE_URL=https://api-merchant.payos.vn

# Suggested production example
# NODE_ENV=production
# PORT=3000
# PUBLIC_BASE_URL=https://comcogiang.io.vn
# SESSION_SECRET=8f4d1a9c0e7b2f6a4d3c8e1f9b7a6c5d4e2f1a9b0c8d7e6f
# ADMIN_INITIAL_PASSWORD=hachitu123A@
# COOKIE_SECURE=1
# PAYOS_CLIENT_ID=your-payos-client-id
# PAYOS_API_KEY=your-payos-api-key
# PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# PAYOS_AUTO_SYNC_MS=30000
# PAYOS_BASE_URL=https://api-merchant.payos.vn
